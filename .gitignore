# CyberZonic baseline gitignore

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
*.crt
*.cer
*.kdbx
secrets/
private/
recovery-codes/

# Node / web
node_modules/
.next/
out/
dist/
build/
coverage/
.turbo/
.vercel/

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs
*.log
logs/

# Local artifacts
*.local
*.tmp
*.bak